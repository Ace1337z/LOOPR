# Copy to .env and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# The anon key is safe to ship in a client. It is protected by row level
# security, which is what actually guards the data -- not the key itself.
# Never put the service_role key in here; it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key